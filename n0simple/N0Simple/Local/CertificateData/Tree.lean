set_option maxHeartbeats 0
set_option maxRecDepth 100000

namespace N0Simple.Local.CertificateData

open N0Simple.Local.LocalDual
open N0Simple.Local.HybridCertificate

def tree : Tree := node0

theorem tree_check : tree.check projected rootState = true := by
  simpa only [tree, state0] using node0_check

noncomputable def certificate : Certificate := ⟨phases, projected, tree⟩

theorem certificate_check : certificate.check = true := by
  simpa only [certificate, Certificate.check] using
    (Bool.and_eq_true_iff.mpr ⟨projected_check, tree_check⟩)

end N0Simple.Local.CertificateData
